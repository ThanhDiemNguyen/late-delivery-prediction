# Template for the local .env file. Copy it with: cp .env.example .env
# The real .env holds local credentials and is never committed (see .gitignore).
# Each service's commit adds its variables here, with placeholder values only.
# Change every "change-me" value in your .env before the first start.

# Prefix for Docker Compose container, network and volume names.
COMPOSE_PROJECT_NAME=late-delivery-prediction

# Postgres superuser for the core Postgres server (databases: oms, dwh, airflow, metastore, datahub).
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me-postgres

# SeaweedFS S3 admin identity (used by the generator, Spark, Trino and DataHub).
S3_ACCESS_KEY=platform
S3_SECRET_KEY=change-me-seaweedfs

# Spark worker size. 4 cores and 4g for the dev slice; the 100 GB benchmarks use 8 and 10g.
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=4g

# Airflow. The Fernet key encrypts connections in the metadata database; generate it once with
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_ADMIN_PASSWORD=change-me-airflow
AIRFLOW_FERNET_KEY=change-me-fernet-key
AIRFLOW_SECRET_KEY=change-me-secret-key

# DataHub. Any long random strings.
DATAHUB_ADMIN_PASSWORD=change-me-datahub
DATAHUB_SECRET=change-me-datahub-secret
DATAHUB_TOKEN_SIGNING_KEY=change-me-signing-key
DATAHUB_TOKEN_SALT=change-me-salt
